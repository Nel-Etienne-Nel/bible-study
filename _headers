# Cloudflare headers. Copied into dist/ by build.js.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Pages themselves use Cloudflare's default, which revalidates every request.
# Scripts, styles and data are linked with a content hash (?v=...), so a
# changed file always arrives under a new URL — safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable
